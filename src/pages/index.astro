---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import headShot from '../../public/headshot.png';
import UWShield from '../../public/shield.png'
import hivemind from '../../public/hivemind.png'
---

<Layout title="Digitalism Aesthetic">
  
	<main class="min-h-screen p-4 md:p-8 font-sans selection:bg-amber-400 animate-boot bg-transparent opacity-0">
		
		<div class="max-w-6xl mx-auto border border-black min-h-[90vh] flex flex-col bg-white backdrop-blur-sm">
			<div class="fixed top-0 right-0">
				<div class="w-72 h-24 bg-[linear-gradient(90deg,rgba(255,255,255,1)_28%,rgba(254,189,48,1)_66%,rgba(240,20,0,1)_100%)]"></div>
				<div class="absolute top-4 right-4 text-[10px] font-mono leading-tight text-white text-right">
					::::::::: <br />
					:::::::::::::: <br />
					::::::::::::::::::::::::::::::: <br />
					::::::: <br />
					::::::::::
				</div>
      		</div>
			<section class="grow flex flex-col items-center justify-center p-4 gap-2 border-b border-black relative overflow-hidden">
				
				<h1 class="text-6xl md:text-8xl font-black tracking-tighter uppercase leading-none mt-auto">
					EDISON WANG
				</h1>
				
				<div class="w-full mt-auto flex justify-between items-end">
					<div class="border border-black p-2 flex flex-col gap-1">
						<span class="text-[10px] font-bold leading-none uppercase">Norm ISO/IEC</span>
						<span id="current-date" class="text-3xl font-bold leading-none border-t border-black pt-1"></span>
						
						<script is:inline>
						const dateSpan = document.querySelector('#current-date');
						if (dateSpan) {
							const date = new Date();
							dateSpan.textContent = date.toLocaleDateString('sv-SE', {year: 'numeric', month: '2-digit', day: '2-digit'}).replaceAll('/', '-');
						}
						</script>
					</div>
					<div class="hidden sm:flex gap-4">

						<!-- Registration Reticle -->
						<svg width="67" height="67" viewBox="0 0 40 40" class="border border-black">
							<path d="M0 0h40v40H0z" fill="none"/>
							<!-- X marker -->
							<path d="M6 6L34 34M34 6L6 34" stroke="black" stroke-width="0.5"/>
							<circle cx="20" cy="20" r="8" fill="none" stroke="black" stroke-width="0.5"/>
							<circle cx="20" cy="20" r="2" fill="black"/>
						</svg>
						<!-- Data Grid -->
						<svg width="67" height="67" viewBox="0 0 40 40" class="border border-black">
							<path d="M0 0h40v40H0z" fill="none"/>
							<g stroke="black" stroke-width="0.4">
								<path d="M0 10h40M0 20h40M0 30h40"/>
								<path d="M10 0v40M20 0v40M30 0v40"/>
							</g>
							<rect x="20" y="10" width="10" height="10" fill="black"/>
						</svg>

						<!-- Scan Frame -->
						<svg width="67" height="67" viewBox="0 0 40 40" class="border border-black">
							<path d="M0 0h40v40H0z" fill="none"/>
							<path d="M4 10V4h6M30 4h6v6M36 30v6h-6M10 36H4v-6"
								fill="none" stroke="black" stroke-width="1"/>
							<circle cx="20" cy="20" r="1.5" fill="black"/>
						</svg>

							<!-- Target / Cross -->
						<svg width="67" height="67" viewBox="0 0 40 40" class="border border-black">
							<path d="M0 0h40v40H0z" fill="none"/>
							<path d="M20 0v40M0 20h40" stroke="black" stroke-width="0.5"/>
							<circle cx="20" cy="20" r="10" fill="black"/>
						</svg>
					</div>
				</div>
			</section>

			<nav class="grid grid-cols-1 md:grid-cols-4 border-b border-black font-mono text-xs font-bold uppercase">
