						<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-black">
							<circle cx="12" cy="12" r="10" />
							<ellipse cx="12" cy="12" rx="3" ry="10" />
							<ellipse cx="12" cy="12" rx="7" ry="10" />
							<line x1="2" y1="12" x2="22" y2="12" />
							<path d="M3.6 16h16.8" />
							<path d="M3.6 8h16.8" />
						</svg>
					</div>
				</div>
			</section>
			<div class="relative flex overflow-x-hidden border-t border-black bg-black text-white py-2 font-mono text-xs font-bold uppercase tracking-widest">
				<div class="animate-marquee whitespace-nowrap flex">
					<span class="mx-4">|</span>
					<span class="mx-4">My Top Ten:</span>
					<span class="mx-4">Justice</span>
					<span class="mx-4">Digitalism</span>
					<span class="mx-4">L'Impératrice</span>
					<span class="mx-4">Daft Punk</span>
					<span class="mx-4">Bonobo</span>
					<span class="mx-4">Gesaffelstein</span>
					<span class="mx-4">STRFKR</span>
					<span class="mx-4">Kavinsky</span>
					<span class="mx-4">Miami Horror</span>
					<span class="mx-4">Kanye (pre-crashout)</span>
					<span class="mx-4">|</span>
					<span class="mx-4">My Top Ten:</span>
					<span class="mx-4">Justice</span>
					<span class="mx-4">Digitalism</span>
					<span class="mx-4">L'Impératrice</span>
					<span class="mx-4">Daft Punk</span>
					<span class="mx-4">Bonobo</span>
					<span class="mx-4">Gesaffelstein</span>
					<span class="mx-4">STRFKR</span>
					<span class="mx-4">Kavinsky</span>
					<span class="mx-4">Miami Horror</span>
					<span class="mx-4">Kanye (pre-crashout)</span>
					
				</div>
			</div>
			<section class="hidden md:grid p-6 gap-4 bg-white/50 backdrop-blur-sm h-40">
				
			</section>
			<section id="about" class=" p-6 flex flex-col gap-4 bg-white/50 backdrop-blur-sm">
				<div class="flex items-center gap-2">
					<div class="w-2 h-2 bg-black"></div>
					<h2 class="font-mono text-[10px] uppercase tracking-[0.2em] font-bold">
