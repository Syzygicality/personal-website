							<li>Racket</li>
						</ul>
					</div>

					<div class="flex flex-col gap-2">
						<div class="border-b border-black pb-1 text-center">
							<span class="font-mono text-[9px] font-bold uppercase tracking-widest">Frameworks & Libraries</span>
						</div>
						<ul class="font-mono text-sm leading-tight grid grid-cols-3 gap-1 justify-items-center">
