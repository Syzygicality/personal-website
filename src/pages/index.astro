					<div class="w-2 h-2 bg-white"></div>
					<h2 class="font-mono text-[10px] uppercase tracking-[0.2em] font-bold">
					Section_02 // Repository
					</h2>
				</div>
				<h3 class="text-2xl md:text-4xl font-bold">
					My Projects
